APP_NAME="AutoSpa M&A"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos PostgreSQL (Supabase)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=

# Producción en Vercel (Settings → Environment Variables), valores SIN comillas:
#   APP_ENV=production
#   APP_DEBUG=false
#   DB_HOST=aws-0-us-east-1.pooler.supabase.com
#   DB_PORT=6543                      (transaction mode; usa 5432 para migraciones)
#   DB_USERNAME=postgres.<project-ref>
#   DB_PASSWORD=<tu contraseña de Supabase>
#   DB_SSLMODE=require
#   DB_EMULATE_PREPARES=true          (obligatorio con el puerto 6543)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Correo. Con "log" los correos NO se envían, se guardan en storage/logs/laravel.log (sirve para probar).
# Para enviar de verdad con Gmail:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SCHEME=null
#   MAIL_USERNAME=tu_correo@gmail.com
#   MAIL_PASSWORD="clave de aplicación de 16 letras"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notificaciones@autospa.com"
MAIL_FROM_NAME="${APP_NAME}"
